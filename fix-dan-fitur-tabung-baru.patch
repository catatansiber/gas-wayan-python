From b3aa8081d7292a74028ba7e94c0f64a7142c702e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 27 Sep 2026 22:04:13 +0800
Subject: [PATCH 1/2] Perbaiki pesan error CylinderNotFound dan NoActiveCycle

Sebelumnya kedua exception ini di-raise dengan serial_number mentah
sebagai argumen (tanpa format kalimat), sehingga messages.error() di
views.py menampilkan pesan kosong seperti hanya "12345" ke user saat
tabung tidak ditemukan atau tidak punya siklus aktif. Sekarang pesan
dibentuk sebagai kalimat lengkap, konsisten dengan exception domain
lain (mis. CylinderNotAvailable) di file yang sama.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01NMtMKH3r6SPyh3vtBVYvUy
---
 operations/services.py | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/operations/services.py b/operations/services.py
index be32b0f..83685ef 100644
--- a/operations/services.py
+++ b/operations/services.py
@@ -115,7 +115,7 @@ def _lock_cylinder(serial_number):
     try:
         return Cylinder.objects.select_for_update().get(serial_number=serial_number)
     except Cylinder.DoesNotExist:
-        raise CylinderNotFound(serial_number) from None
+        raise CylinderNotFound(f"Tabung {serial_number} tidak ditemukan.") from None
 
 
 def _lock_open_cycle(cylinder):
@@ -125,7 +125,9 @@ def _lock_open_cycle(cylinder):
         .first()
     )
     if cycle is None:
-        raise NoActiveCycle(cylinder.serial_number)
+        raise NoActiveCycle(
+            f"Tabung {cylinder.serial_number} tidak memiliki siklus aktif (belum dikirim atau sudah kembali)."
+        )
     return cycle
 
 

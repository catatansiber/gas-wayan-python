# Salin file ini menjadi .env lalu sesuaikan bila perlu. Jangan commit .env asli.
# Proyek ini terpisah total dari ../Gas Wayan/.env (proyek TypeScript lama) - jangan disalin.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-change-me-not-for-production-use-a-generated-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL lokal (docker-compose.yml proyek ini, bukan compose.yaml lama)
DATABASE_URL=postgres://gaswayan:gaswayan_dev_password@localhost:55432/gaswayan_dev

# Zona waktu tampilan bisnis (lihat CLAUDE.md / requirements.md lama)
TIME_ZONE=Asia/Makassar
